<Window x:Class="Task2.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task2"
        mc:Ignorable="d"
        Title="MainWindow" Height="350" Width="500"
        FontSize="20">
    <Grid Background="#a7e">
        
        <StackPanel HorizontalAlignment="Center" Margin="0 0 0 5">
            
            <TextBlock Text="Адрес эл. почты" Foreground="White" FontWeight="Bold"/>
            <TextBox x:Name="mailAddressTextBox" Width="300" TextWrapping="NoWrap" Margin="0 0 0 5" FontSize="16"
                     Text="{Binding RecipientMailAddress}"/>

            <Button HorizontalAlignment="Left" Content="Отправить" Width="130" Grid.Row="2"
                Foreground="White" FontWeight="Bold" Background="#85c"
                Command="{Binding SendMessageCommand}" CommandParameter="{Binding RecipientMailAddress}"/>

            
            <TextBlock Text="Проверка кода" Foreground="White" FontWeight="Bold"/>
            <TextBox x:Name="mailHeaderTextBox"  Width="300" TextWrapping="NoWrap" FontSize="16"
                     Text="{Binding Code}"/>

            <Button HorizontalAlignment="Left" Content="Проверить" Width="130" Grid.Row="2"
                Foreground="White" FontWeight="Bold" Background="#85c"
                Command="{Binding CheckCodeCommand}" CommandParameter="{Binding Code}"/>
            
        </StackPanel>
    </Grid>
</Window>
