<Window x:Class="Task3.Views.AuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Task3"
        mc:Ignorable="d"
        Title="AuthorizationWindow" Height="350" Width="500"
        FontSize="20">
    <Grid Background="#a7e">
        
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0 0 0 5">
            
            <TextBlock Text="Проверка кода" Foreground="White" FontWeight="Bold"/>
            <TextBox x:Name="mailHeaderTextBox"  Width="300" TextWrapping="NoWrap" FontSize="16"
                     Text="{Binding Code}"/>

            <StackPanel Margin="0 5 0 0">
                <Button HorizontalAlignment="Left" Content="Проверить" Width="130" Grid.Row="2"
                Foreground="White" FontWeight="Bold" Background="#85c" Margin="0 0 0 5"
                Command="{Binding CheckCodeCommand}" CommandParameter="{Binding Code}"/>

                <Button HorizontalAlignment="Left" Content="Отправить повторно" Width="230" Grid.Row="2"
                Foreground="White" FontWeight="Bold" Background="#85c"
                Command="{Binding RepeatedSendCodeCommand}"/>
            </StackPanel>
            
        </StackPanel>
    </Grid>
</Window>
